{
  "name": "cerberus",
  "displayName": "Cerberus",
  "description": "An Antigravity extension for developing Keras 3 models the right way.",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:cerberus.statusView",
    "onView:cerberus.coreModulesView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cerberus.runChecks",
        "title": "Cerberus: Run Backend Compatibility Checks"
      },
      {
        "command": "cerberus.classifyAsTest",
        "title": "Cerberus: Classify as Test Suite"
      },
      {
        "command": "cerberus.classifyAsCore",
        "title": "Cerberus: Classify as Core Module"
      },
      {
        "command": "cerberus.removeClassification",
        "title": "Cerberus: Remove Classification"
      },
      {
        "command": "cerberus.generateSummary",
        "title": "Cerberus: Generate Core Module Summary"
      },
      {
        "command": "cerberus.toggleAgent",
        "title": "Cerberus: Toggle Agent Summaries"
      }
    ],
    "submenus": [
      {
        "id": "cerberus.contextMenu",
        "label": "Cerberus"
      }
    ],
    "configuration": {
      "title": "Cerberus",
      "properties": {
        "cerberus.targetFile": {
          "type": "string",
          "default": "model.py",
          "description": "The entry point script for backend compatibility checks."
        },
        "cerberus.activeHeads": {
          "type": "array",
          "default": [
            "tensorflow",
            "jax",
            "torch"
          ],
          "description": "The active backend heads to check for compatibility.",
          "items": {
            "type": "string",
            "enum": [
              "tensorflow",
              "jax",
              "torch"
            ]
          }
        },
        "cerberus.testSuiteFiles": {
          "type": "array",
          "default": [],
          "description": "Files classified as Test Suite (will be executed on save).",
          "items": {
            "type": "string"
          }
        },
        "cerberus.coreModuleFiles": {
          "type": "array",
          "default": [],
          "description": "Files classified as Core Modules (will be analyzed for compatibility).",
          "items": {
            "type": "string"
          }
        },
        "cerberus.enableAgentSummaries": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable AI agent summaries for failed tests."
        },
        "cerberus.monitorCoreModules": {
          "type": "boolean",
          "default": false,
          "description": "Monitor Core Module changes for compatibility issues on save."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cerberus-sidebar",
          "title": "Cerberus",
          "icon": "media/cerberus-icon.svg"
        }
      ]
    },
    "views": {
      "cerberus-sidebar": [
        {
          "id": "cerberus.statusView",
          "name": "Test Suite Status",
          "type": "webview"
        },
        {
          "id": "cerberus.coreModulesView",
          "name": "Core Modules",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "submenu": "cerberus.contextMenu",
          "group": "cerberus_group"
        }
      ],
      "explorer/context": [
        {
          "submenu": "cerberus.contextMenu",
          "group": "cerberus_group"
        }
      ],
      "cerberus.contextMenu": [
        {
          "command": "cerberus.classifyAsTest",
          "group": "1_classification@1"
        },
        {
          "command": "cerberus.classifyAsCore",
          "group": "1_classification@2"
        },
        {
          "command": "cerberus.removeClassification",
          "group": "1_classification@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npx tsc -p ./",
    "watch": "npx tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "npx eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.89.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "glob": "^8.1.0",
    "mocha": "^10.4.0",
    "typescript": "^5.4.5",
    "@vscode/test-electron": "^2.3.9"
  },
  "overrides": {
    "@types/minimatch": "5.1.2",
    "minimatch": "5.1.6",
    "glob": {
      "minimatch": "5.1.6"
    }
  }
}
